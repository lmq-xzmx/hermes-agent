{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hermes File Manager",
  "version": "1.0.0",
  "identifier": "com.hermes.file-manager",
  "build": {
    "frontendDist": "../web/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/**",
          "**/*"
        ]
      },
      "csp": "default-src 'self' 'unsafe-inline' blob: data:; connect-src 'self' http://localhost:* https://localhost:* ws://localhost:* wss://localhost:* http://127.0.0.1:* https://127.0.0.1:* https://api.yourdomain.com; script-src 'self' 'unsafe-inline' blob:; style-src 'self' 'unsafe-inline' blob: data: asset: https://localhost:*; img-src 'self' data: blob: asset: https://localhost:*; font-src 'self' data: blob: asset: https://localhost:*; frame-src 'self' blob: asset:; worker-src 'self' blob:;"
    },
    "windows": [
      {
        "title": "Hermes File Manager",
        "width": 1100,
        "height": 700,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "url": "vue.html",
        "label": "main"
      },
      {
        "title": "快捷浮窗",
        "width": 360,
        "height": 480,
        "minWidth": 280,
        "minHeight": 360,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "url": "floating-vue.html",
        "label": "floating",
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "decorations": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../web/dist": ""
    },
    "copyright": "Copyright 2024 Hermes Agent",
    "category": "Productivity"
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
